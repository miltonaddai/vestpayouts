# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/dev.log

# local screenshots
/tmp-shots/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# hosting
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# Local on-chain ingest output (used when Supabase is not configured)
/data/onchain-store.json
/data/onchain-store.json.tmp
