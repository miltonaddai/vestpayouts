# Copy to apps/web/.env.local. Never commit real keys.
# The website reads published payouts with the publishable key (RLS applies).
# It does not get the secret key (or the legacy service-role key).

# Canonical origin, no trailing slash. Defaults to https://vestpayouts.com when unset.
# On this machine use http://127.0.0.1:4317.
NEXT_PUBLIC_SITE_URL=https://vestpayouts.com

# Public Supabase. Prefer the publishable key (sb_publishable_...).
# NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback.
# The local demo anon JWT below works only against `yarn db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# API base URL. Server-only. Admin writes and click logging are proxied here.
# In production this is the Railway API origin, e.g. https://vestpayouts-api.up.railway.app
BACKEND_URL=http://127.0.0.1:4318

# Shared with the API. Authorizes POST /clicks and nothing else.
CLICK_LOG_SECRET=replace-with-a-long-random-string

# The API calls POST /api/revalidate with this bearer token after it writes data.
REVALIDATE_SECRET=replace-with-a-long-random-string

# Owner's Vest referral. Leave both empty and CTAs still go to https://www.vestmarkets.com/ with UTMs.
NEXT_PUBLIC_VEST_REFERRAL_URL=
NEXT_PUBLIC_VEST_REFERRAL_CODE=
NEXT_PUBLIC_VEST_REFERRAL_PARAM=ref
NEXT_PUBLIC_REFERRAL_APPEND_UTM=true

NEXT_PUBLIC_CONTACT_EMAIL=hello@vestpayouts.com
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
