# Copy to apps/api/.env.local. Never commit real keys.
# This process is the only one that should hold the Supabase service-role key
# or the Alchemy API key. Do not put ALCHEMY_API_KEY on the website or prefix it with NEXT_PUBLIC_.

PORT=4318

# Accepts SUPABASE_URL or, for older setups, NEXT_PUBLIC_SUPABASE_URL.
# Leave these unset (or set INGEST_STORE=local) to write ingested payouts to
# data/onchain-store.json, which the website reads in local dev.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Gates /admin/*. Unset and the admin page explains how to turn itself on.
ADMIN_PASSWORD=change-me

# Must match CLICK_LOG_SECRET on the website. Authorizes POST /clicks only.
CLICK_LOG_SECRET=replace-with-a-long-random-string

# After a write, POST {REVALIDATE_URL}/api/revalidate with this bearer token.
REVALIDATE_URL=http://127.0.0.1:4317
REVALIDATE_SECRET=replace-with-a-long-random-string

# Optional. Five-field cron, UTC. Recommended cadence once a cursor exists: every 12 minutes.
# Example: */12 * * * *
# Leave empty in local `yarn dev` if you do not want the API to scan the chains on its own.
INGEST_CRON=

# Optional. Authorizes POST /internal/ingest for an external scheduler.
CRON_SECRET=

# Optional webhook that receives the same referral-click payload stored in Supabase.
REFERRAL_WEBHOOK_URL=

# Alchemy (API process only). Derives:
#   https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
#   https://arb-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# Free-tier note: eth_getLogs is limited to a 10-block range on Base/Arbitrum, so ingest
# defaults to alchemy_getAssetTransfers (120 CU/page, up to 1000 transfers + timestamps).
# Incremental runs after the first sync are typically 1 request per chain.
ALCHEMY_API_KEY=

# Optional overrides. If unset, the Alchemy URLs above are used when ALCHEMY_API_KEY is set.
BASE_RPC_URL=
ARBITRUM_RPC_URL=

# transfers (default on Alchemy) or logs (eth_getLogs fallback).
INGEST_METHOD=transfers

# Hard cap on JSON-RPC HTTP requests per ingest run (default 300).
INGEST_MAX_REQUESTS=300

# local = data/onchain-store.json; supabase = write through the service role.
# If unset, local is used whenever Supabase write keys are missing.
INGEST_STORE=local
