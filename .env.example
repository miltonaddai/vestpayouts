# Copy to .env.local. Never commit real keys.

# Public site URL, no trailing slash. Used for canonical links, sitemap and OG URLs.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4317

# Supabase. Local `supabase start` prints these; the CLI 3 status output omits keys,
# and the local demo JWTs below are the standard ones every Supabase local stack uses.
# Production: Project Settings → API in the Supabase dashboard. Use the anon key here
# and the service_role key only in SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Owner's Vest referral. Set the full URL from the Vest dashboard, or just the code.
# Leave both empty and every CTA still links to https://www.vestmarkets.com/ with UTMs.
NEXT_PUBLIC_VEST_REFERRAL_URL=
NEXT_PUBLIC_VEST_REFERRAL_CODE=
NEXT_PUBLIC_VEST_REFERRAL_PARAM=ref
# Set to "false" if Vest's own tracking breaks when UTM params are appended.
NEXT_PUBLIC_REFERRAL_APPEND_UTM=true

# Optional. POST /api/revalidate with `Authorization: Bearer <secret>` refreshes cached pages
# after an ingest. yarn ingest calls it when both this and NEXT_PUBLIC_SITE_URL are set.
REVALIDATE_SECRET=replace-with-a-long-random-string

# Password for /admin. Unset = the admin page explains how to enable itself.
ADMIN_PASSWORD=change-me

# Optional webhook that receives the same referral-click payload stored in Supabase.
REFERRAL_WEBHOOK_URL=

# Optional archive RPC endpoints. Free public RPCs cannot see old Base history.
BASE_RPC_URL=
ARBITRUM_RPC_URL=

# Optional contact shown on about / privacy / terms.
NEXT_PUBLIC_CONTACT_EMAIL=hello@paidtape.com
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
